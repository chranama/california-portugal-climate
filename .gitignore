# Python
__pycache__/
*.pyc

# Virtual environments
.venv/

# DuckDB artifacts
data/warehouse/*.duckdb
data/warehouse/*.wal
.duckdb/
.duckdb*  

# Raw and intermediate data
data/raw/
data/external/

# Runtime predictions are ignored by default; keep the curated evidence sample.
data/mart/**
!data/mart/
!data/mart/predictions/
!data/mart/predictions/baseline_rf_predictions.csv

# Jupyter
.ipynb_checkpoints/

# dbt generated
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Runtime logs
logs/

# Model outputs are ignored by default; keep curated baseline evidence artifacts.
models/*
!models/baseline_rf.pkl
!models/baseline_rf_metrics.json

*.DS_Store

**/*.egg-info/
